<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Rekordit_Finally.Views"
       x:Class="Rekordit_Finally.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light=#FCFCFE, Dark=#151820}"
       Shell.ForegroundColor="{AppThemeBinding Light=#101522, Dark=#F3F5FA}"
       Shell.TitleColor="{AppThemeBinding Light=#101522, Dark=#F3F5FA}">
    <ShellContent Title="Screen to GIF"
                  Route="home"
                  ContentTemplate="{DataTemplate views:Home}" />
</Shell>
