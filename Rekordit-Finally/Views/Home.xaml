<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rekordit_Finally.Views.Home"
             Title="Screen to GIF" Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#FCFCFE, Dark=#151820}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Padding="24" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Screen to GIF" Style="{StaticResource HomeHeading}" />
            <Button Grid.Column="1" Text="⚙" FontSize="24" Padding="8" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#101522, Dark=#F3F5FA}"
                    SemanticProperties.Description="Settings" Clicked="OnSettings" />
        </Grid>
        <Button x:Name="SelectButton" Grid.Row="1" Text="Select Area" Style="{StaticResource HomeButton}"
                VerticalOptions="Center" Clicked="OnSelectArea" />
        <Label Grid.Row="2" Text="Files stay on your Mac." FontSize="14" HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=#7D859B, Dark=#AAB3C6}" />
    </Grid>
</ContentPage>
