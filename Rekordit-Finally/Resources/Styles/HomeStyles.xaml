<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="HomeInk">#101522</Color>
    <Color x:Key="HomeMuted">#7D859B</Color>
    <Color x:Key="HomeBlue">#0866FF</Color>
    <Style x:Key="HomeLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeInk}, Dark=#F3F5FA}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="HomeHeading" TargetType="Label" BasedOn="{StaticResource HomeLabel}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="HomePicker" TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeInk}, Dark=#F3F5FA}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource HomeMuted}, Dark=#AAB3C6}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>
    <Style x:Key="HomeButton" TargetType="Button">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="BackgroundColor" Value="{StaticResource HomeBlue}" />
        <Setter Property="TextColor" Value="White" />
    </Style>
</ResourceDictionary>
